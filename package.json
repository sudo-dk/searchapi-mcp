{
  "name": "searchapi-mcp",
  "version": "0.2.0",
  "description": "Model Context Protocol server for SearchApi.io: live, LLM-sized results from Google, Google Jobs, Shopping, News, Scholar, YouTube and 100+ other engines.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "searchapi-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/searchapi.test.mjs",
    "smoke": "npm run build && node --env-file=.env scripts/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "searchapi",
    "serp",
    "google-search",
    "ai-agents",
    "llm",
    "claude",
    "search"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
